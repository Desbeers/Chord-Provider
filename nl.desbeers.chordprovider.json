{
  "id": "nl.desbeers.chordprovider",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.swift6"
  ],
  "command": "ChordProvider",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--filesystem=host",
    "--filesystem=xdg-run/pipewire-0"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/swift6/bin",
    "prepend-ld-library-path": "/usr/lib/sdk/swift6/lib"
  },
  "modules": [
    {
      "name": "fluidsynth",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-Denable-sdl3=OFF"
      ],
      "sources": [
          {
              "type": "git",
              "url": "https://github.com/FluidSynth/fluidsynth.git",
              "tag": "v2.5.4",
              "commit": "57c19522838331da5aeae95433b0d776734907d8"
          }
      ]
    },
    {
      "name": "libspelling",
      "buildsystem": "meson",
      "config-opts": [
          "-Dintrospection=disabled",
          "-Ddocs=false"
      ],
      "sources": [
          {
            "type": "archive",
            "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.10.tar.xz",
            "sha256": "56e3f01a3a18b575beea4c34349f99cdaba316e1f7c271b1231f7bcf5d9af73b",
            "x-checker-data": {
                "type": "gnome",
                "name": "libspelling"
            }
          }
      ]
    },
    {
      "name": "ChordProvider",
      "builddir": true,
      "buildsystem": "simple",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ],
      "build-commands": [
        "swift build --configuration release --package-path Package --cache-path .cache --build-path .flatpak/swift --static-swift-stdlib --product ChordProviderGnome",
        "install -Dm755 .flatpak/swift/release/ChordProviderGnome /app/bin/ChordProvider",
        "cp -r .flatpak/swift/release/ChordProvider_ChordProviderGnome.bundle/ /app/bin",
        "cp -r .flatpak/swift/release/ChordProvider_ChordProviderCore.bundle/ /app/bin",
        "cp -r .flatpak/swift/release/ChordProvider_SourceView.bundle/ /app/bin",
        "install -Dm644 Package/ChordProviderGnome/Resources/nl.desbeers.chordprovider.svg /app/share/icons/hicolor/scalable/apps/nl.desbeers.chordprovider.svg",
        "install -Dm644 Package/ChordProviderGnome/Resources/nl.desbeers.chordprovider-symbolic.svg /app/share/icons/hicolor/symbolic/apps/nl.desbeers.chordprovider-symbolic.svg",
        "install -Dm644 Package/ChordProviderGnome/Resources/nl.desbeers.chordprovider-mime.svg /app/share/icons/hicolor/scalable/mimetypes/nl.desbeers.chordprovider-doc.svg",
        "install -Dm644 Package/ChordProviderGnome/Resources/nl.desbeers.chordprovider.metainfo.xml /app/share/metainfo/nl.desbeers.chordprovider.metainfo.xml",
        "install -Dm644 Package/ChordProviderGnome/Resources/nl.desbeers.chordprovider.desktop /app/share/applications/nl.desbeers.chordprovider.desktop",
        "install -Dm644 Package/ChordProviderGnome/Resources/nl.desbeers.chordprovider.mime.xml /app/share/mime/packages/nl.desbeers.chordprovider.mime.xml",
        "update-mime-database /app/share/mime",
        "desktop-file-install --rebuild-mime-info-cache --dir=/app/share/applications /app/share/applications/nl.desbeers.chordprovider.desktop"
      ]
    }
  ]
}

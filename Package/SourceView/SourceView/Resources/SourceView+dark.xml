<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="SourceView-dark" name="SourceView Dark" version="1.0" parent-scheme="Adwaita-dark">
    <author>Nick Berendsen</author>
    <_description>Default theme for SourceView</_description>
    <metadata>
      <property name="variant">dark</property>
      <property name="light-variant">SourceView-light</property>
    </metadata>
    <style name="chordpro:chord" foreground="#1a5fb4" scale="x-large"/>
    <style name="chordpro:tag"   foreground="#613583" scale="0.8"/>
    <style name="chordpro:title" bold="true" scale="x-large"/>
</style-scheme>
